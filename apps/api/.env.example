# Copia este archivo como .env y completa los valores. Nunca subas el .env a git.

NODE_ENV=development
API_PORT=4000

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://etapa:etapa@localhost:5432/etapa_productiva?schema=public"

# URL del frontend (CORS y redirección después del login)
FRONTEND_URL=http://localhost:5173

# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (Aplicación web)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Debe estar registrado tal cual en "URIs de redireccionamiento autorizados"
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Firma de la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres

# Clave AES-256 para cifrar los tokens OAuth (32 bytes en base64). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la cambias, todos los usuarios tendrán que volver a iniciar sesión.
TOKEN_ENCRYPTION_KEY=

# Carpeta donde se guardan las hojas de vida (privada, fuera de git)
STORAGE_DIR=./storage

# Envío de correos: "real" usa la Gmail API; "simulado" no envía nada y solo lo muestra en la consola.
GMAIL_MODO=real
# Pon false si no quieres que este proceso envíe la cola (por ejemplo, en un segundo servidor).
COLA_ACTIVA=true
